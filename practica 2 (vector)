# Importamos la librería NumPy, que se usa para cálculo numérico
import numpy as np
# Se crea un arreglo (vector) de una dimensión con los valores dados
vector = np.array([1, 2, 3, 4, 5])
#se muestra el vector
print("Vector:", vector)
# shape indica la estructura del arreglo
# (5,) significa que tiene 5 elementos en una sola dimensión
print("Forma:", vector.shape)
# size indica el número total de elementos del arreglo
print("Tamaño:", vector.size)
# dtype indica el tipo de dato almacenado en el arreglo
# Ejemplo: int32, int64, float64, etc.
print("Tipo de dato:", vector.dtype)
# En NumPy todos los elementos tienen el mismo tipo
print("Tipo de dato del contenido:", vector.dtype)
# En Python los índices empiezan en 0
print("Primer elemento:", vector[0])
# -1 accede al último elemento del vector
print("Último elemento:", vector[-1])
# -2: significa desde el penúltimo hasta el final
print("Dos últimos elementos:", vector[-2:])

